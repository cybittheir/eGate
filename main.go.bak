package main

import (
	"crypto/tls"
	"errors"
	"flag"
	"io"
	"log"
	"net"
	"os"
	"strings"

	client "net/smtp"

	server "github.com/emersion/go-smtp"
	"golang.org/x/crypto/bcrypt"
	"gopkg.in/yaml.v3"
)

type ConfigRemote struct {
	Host     string `yaml:"host"`
	Port     string `yaml:"port"`
	User     string `yaml:"user"`
	Password string `yaml:"password"`
	From     string `yaml:"from"`
}

type ConfigLocal struct {
	Addr   string `yaml:"addr"`
	Domain string `yaml:"domain"`
}

type Config struct {
	Local         ConfigLocal  `yaml:"local"`
	Remote        ConfigRemote `yaml:"remote"`
	WhitelistPath string       `yaml:"whitelist_path"`
}

type WhitelistEntry struct {
	PasswordHash string `yaml:"password_hash"`
}

type Whitelist struct {
	Entries map[string]WhitelistEntry `yaml:"entries"`
}

func loadConfig(path string) (*Config, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		return nil, err
	}
	var cfg Config
	return &cfg, yaml.Unmarshal(data, &cfg)
}

func loadWhitelist(path string) (*Whitelist, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		return nil, err
	}
	var wl Whitelist
	return &wl, yaml.Unmarshal(data, &wl)
}

func main() {
	configPath := flag.String("config", "config.yaml", "config file path")
	flag.Parse()

	cfg, err := loadConfig(*configPath)
	if err != nil {
		log.Fatal("failed to load config:", err)
	}

	wl, err := loadWhitelist(cfg.WhitelistPath)
	if err != nil {
		log.Fatal("failed to load whitelist:", err)
	}

	be := &backend{cfg: cfg, whitelist: wl}
	s := server.NewServer(be)
	s.Addr = cfg.Local.Addr
	s.Domain = cfg.Local.Domain
	s.AllowInsecureAuth = true
	s.Debug = os.Stdout

	log.Printf("SMTP gateway listening on %s", s.Addr)
	if err := s.ListenAndServe(); err != nil {
		log.Fatal(err)
	}
}

type backend struct {
	cfg       *Config
	whitelist *Whitelist
}

// Auth logic: checks if IP is whitelisted and validates password if required
func (b *backend) Login(state *server.ConnectionState, username, password string) (server.Session, error) {
	host, _, _ := net.SplitHostPort(state.RemoteAddr.String())
	entry, ok := b.whitelist.Entries[host]

	if !ok {
		return nil, errors.New("IP not whitelisted")
	}

	// Verify the hashed password from whitelist.yaml
	if entry.PasswordHash != "" {
		err := bcrypt.CompareHashAndPassword([]byte(entry.PasswordHash), []byte(password))
		if err != nil {
			log.Printf("Auth failed for IP %s", host)
			return nil, errors.New("invalid credentials")
		}
	}

	log.Printf("Auth successful for IP %s (User: %s)", host, username)
	return &session{cfg: b.cfg, remoteAddr: host, authDone: true}, nil
}

// Handle non-authenticated sessions (only if password_hash is empty for the IP)
func (b *backend) NewSession(c *server.Conn) (server.Session, error) {
	host, _, _ := net.SplitHostPort(c.Conn().RemoteAddr().String())
	_, ok := b.whitelist.Entries[host]
	if !ok {
		log.Printf("Connection rejected: %s not in whitelist", host)
		return nil, errors.New("access denied: IP not whitelisted")
	}
	return &session{cfg: b.cfg, remoteAddr: host, authDone: false}, nil
}

type session struct {
	cfg        *Config
	remoteAddr string
	authDone   bool
	from       string
	to         []string
	data       []byte
}

func (s *session) Mail(from string, opts *server.MailOptions) error {
	// Check if this IP requires auth and if it was performed
	entry := s.cfg.getWhitelistEntry(s.remoteAddr) // helper to find entry
	if entry != nil && entry.PasswordHash != "" && !s.authDone {
		return errors.New("Authentication required for this IP")
	}
	s.from = from
	return nil
}

func (c *Config) getWhitelistEntry(ip string) *WhitelistEntry {
	// In a real app, you'd pass the whitelist into the session or
	// load it into a global-ish map.
	// For this snippet, assume it's accessible.
	return nil
}

func (s *session) Rcpt(to string, _ *server.RcptOptions) error {
	s.to = append(s.to, to)
	return nil
}

func (s *session) Data(r io.Reader) error {
	data, err := io.ReadAll(r)
	if err != nil {
		return err
	}
	s.data = data
	return s.sendToRemoteSMTP()
}

func (s *session) sendToRemoteSMTP() error {
	cfg := s.cfg.Remote
	hostPort := net.JoinHostPort(cfg.Host, cfg.Port)

	conn, err := tls.Dial("tcp", hostPort, &tls.Config{ServerName: cfg.Host})
	if err != nil {
		return err
	}
	defer conn.Close()

	client, err := client.NewClient(conn, cfg.Host)
	if err != nil {
		return err
	}
	defer client.Quit()

	auth := client.PlainAuth("", cfg.User, cfg.Password, cfg.Host)
	if err = client.Auth(auth); err != nil {
		return err
	}

	if err = client.Mail(cfg.From); err != nil {
		return err
	}
	for _, rcpt := range s.to {
		if err = client.Rcpt(rcpt); err != nil {
			return err
		}
	}

	msg := rewriteFromHeader(s.data, cfg.From)
	w, err := client.Data()
	if err != nil {
		return err
	}
	_, err = w.Write(msg)
	w.Close()
	return err
}

func (s *session) Reset()        { s.from = ""; s.to = nil; s.data = nil }
func (s *session) Logout() error { return nil }

func rewriteFromHeader(raw []byte, newFrom string) []byte {
	s := string(raw)

	// Разделяем заголовки и тело по первой пустой строке
	parts := strings.SplitN(s, "\r\n\r\n", 2)
	if len(parts) != 2 {
		// Если по какой-то причине нет разделителя — не трогаем
		return raw
	}
	headers, body := parts[0], parts[1]

	lines := strings.Split(headers, "\r\n")
	found := false

	for i, line := range lines {
		// Поиск существующего From: (без учёта регистра)
		l := strings.ToLower(line)
		if strings.HasPrefix(l, "from:") {
			lines[i] = "From: " + newFrom
			found = true
			break
		}
	}

	if !found {
		// Если заголовка From вообще не было — добавим в начало
		lines = append([]string{"From: " + newFrom}, lines...)
	}

	newHeaders := strings.Join(lines, "\r\n")
	return []byte(newHeaders + "\r\n\r\n" + body)
}
